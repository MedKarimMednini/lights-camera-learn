# Vercel Neon PostgreSQL Database
DATABASE_URL=postgres://user:password@endpoint.neon.tech/neondb?sslmode=require

# Resend Email API (Used for email notifications)
RESEND_API_KEY=re_123456789
DESTINATION_EMAIL=youremail@example.com

# Cloudflare Turnstile (Spam Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Apps Script Webhook (For pushing submissions to Google Sheets)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=your-secure-secret-here
